# Local development only. In AWS these come from SSM Parameter Store (/mordor/*), never env vars.
FIRMS_MAP_KEY=
DATA_GOV_API_KEY=
OPENAQ_API_KEY=
ANTHROPIC_API_KEY=        # parent-message agent, AWS_INTEGRATION.md §5.1 (in AWS: SSM /mordor/anthropic_api_key)
SES_SENDER=              # verified SES identity, AWS_INTEGRATION.md §5.2
LOCATION_API_KEY=        # optional, AWS_INTEGRATION.md §5.3 (the web build reads VITE_LOCATION_API_KEY)
# Leave DATA_BUCKET / TABLE_NAME unset locally: storage falls back to ./.data and DynamoDB writes are skipped.
DATA_BUCKET=
TABLE_NAME=
LOCAL_DATA_DIR=.data
