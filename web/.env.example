# All public. Copy to web/.env for local dev.
# Where runs/*, static/* live. Empty = same origin (CloudFront). Local dev: /dev (written by `make forecast-local`).
VITE_CDN_BASE=/dev
# API base. Empty = read runs/latest.json from the CDN directly (no API needed locally).
VITE_API_BASE=
# Amazon Location Service. Either a full style descriptor URL, or a key + region + style name.
VITE_LOCATION_STYLE_URL=
VITE_LOCATION_API_KEY=
VITE_AWS_REGION=us-east-1
VITE_LOCATION_STYLE=Satellite
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_DEMO_MODE=1   # persona picker and the walkthrough; set only for demo builds (the API needs DemoAuth=1 too)
VITE_DEMO_PASSWORD=   # the six demo personas' shared Cognito password (demo builds only; public in the bundle)
